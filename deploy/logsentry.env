# LogSentry service settings, read by logsentry.service.
# After editing:  sudo systemctl restart logsentry
#
# Files to follow, their format, and response options. See `logsentry watch --help`.
# Starts in PREVIEW mode: it logs the firewall commands it would run.
# When you are happy with what it reports, add --apply to enforce blocks.
# Add --allow <your office IP or network> so you can never be locked out.
LOGSENTRY_ARGS=/var/log/auth.log --format auth --block --firewall iptables --block-ttl 24h
